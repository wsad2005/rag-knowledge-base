# =============================================================================
# RAG Knowledge Base 环境变量示例
# 复制为 .env 后按需修改：cp .env.example .env
# .env 已被 .gitignore 排除，请勿提交任何真实密钥。
# 本文件中的所有值都是占位符，不是可用密钥。
# =============================================================================

# --------------------------------------------------------------------- 应用
APP_NAME=RAG Knowledge Base
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# --------------------------------------------------------------------- 存储
# 数据根目录（上传文件、SQLite、Chroma 都放在这里，默认已被 .gitignore 排除）
DATA_DIR=data

# 默认 SQLite；如需 PostgreSQL：
#   1) pip install -r requirements-postgres.txt
#   2) 取消下面一行注释并改成你的连接串
# DATABASE_URL=postgresql+psycopg://ragkb:ragkb@localhost:5432/ragkb
DATABASE_ECHO=false

# --------------------------------------------------------------------- 上传
UPLOAD_MAX_MB=20
ALLOWED_EXTENSIONS=.pdf,.docx,.txt,.md,.markdown

# --------------------------------------------------------------------- 切分
CHUNK_SIZE=500
CHUNK_OVERLAP=80
MIN_CHUNK_CHARS=20

# --------------------------------------------------------------------- Embedding
# 可选：hashing（默认，零依赖零下载）| sentence-transformers（本地模型）| openai（远程 API）
EMBEDDING_PROVIDER=hashing
# 哈希模式的向量维度
EMBEDDING_DIMENSION=512
# 本地模型名（仅 EMBEDDING_PROVIDER=sentence-transformers 时生效）
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_BATCH_SIZE=32

# 远程 Embedding（仅 EMBEDDING_PROVIDER=openai 时生效，需同时填三项）
# EMBEDDING_API_BASE_URL=https://api.example.com/v1
# EMBEDDING_API_KEY=replace-me
# EMBEDDING_API_MODEL=replace-with-embedding-model
EMBEDDING_API_TIMEOUT_SECONDS=30

# --------------------------------------------------------------------- 向量库
VECTOR_STORE_PROVIDER=chroma
CHROMA_COLLECTION=knowledge_chunks
# 默认落在 DATA_DIR/chroma；也可指定绝对路径
# CHROMA_DIR=data/chroma

# --------------------------------------------------------------------- 检索
RETRIEVAL_TOP_K=5
RETRIEVAL_MAX_TOP_K=20
# 低于该相似度的结果直接丢弃（-1~1，0 表示不过滤）
RETRIEVAL_SCORE_THRESHOLD=0.0
# 送入 Prompt 的上下文字符上限
MAX_CONTEXT_CHARS=4000

# --------------------------------------------------------------------- 大模型（OpenAI 兼容）
# 三项齐全才会启用；缺任一项时问答自动降级为“只返回检索片段”。
# 下面以智谱 GLM 为例，base_url 是公开文档地址，不是密钥。
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_API_KEY=replace-me
# LLM_MODEL=glm-4-flash
LLM_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
